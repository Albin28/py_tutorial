   ],
   "source": [
    "num = float(input(\"Enter a number: \"))\n",
    "guess = num / 2\n",
    "for _ in range(20):  # Newton-Raphson method\n",
    "    guess = (guess + num / guess) / 2\n",
    "print(f\"Square root of {num} ≈ {guess:.5f}\")"
   ]
  }
